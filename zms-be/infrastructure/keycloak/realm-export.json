{
  "realm": "zoo",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "zoo-admin" },
      { "name": "zoo-vet" },
      { "name": "zoo-keeper" }
    ]
  },
  "clients": [
    {
      "clientId": "animal-service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${ANIMAL_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "health-service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${HEALTH_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "zms-fe",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@zoo.local",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Zoo",
      "credentials": [{ "type": "password", "value": "${ZOO_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["zoo-admin"]
    },
    {
      "username": "vet",
      "enabled": true,
      "email": "vet@zoo.local",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Zoo",
      "credentials": [{ "type": "password", "value": "${ZOO_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["zoo-vet"]
    },
    {
      "username": "keeper",
      "enabled": true,
      "email": "keeper@zoo.local",
      "emailVerified": true,
      "firstName": "Karl",
      "lastName": "Zoo",
      "credentials": [{ "type": "password", "value": "${ZOO_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["zoo-keeper"]
    }
  ]
}
