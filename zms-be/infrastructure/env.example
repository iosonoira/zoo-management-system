# Copy to .env in this directory (git-ignored) before running docker compose:
#   cp env.example .env
# Local development only — never reuse these values anywhere else.

# POSTGRES_USER / POSTGRES_PASSWORD must match DB_USERNAME / DB_PASSWORD
# in animal-service/.env, or the service cannot connect.
# Postgres only applies POSTGRES_PASSWORD when the volume is first created;
# to change it later, either run
#   docker exec -it infrastructure-postgres-animal-1 psql -U zoo -d postgres -c "ALTER USER zoo PASSWORD '<value>'"
# or recreate the volume with `docker compose down -v` (drops local data).
POSTGRES_DB=animal_db
POSTGRES_USER=zoo
POSTGRES_PASSWORD=change-me-locally

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally

# Must match OIDC_CLIENT_SECRET in animal-service/.env
OIDC_CLIENT_SECRET=change-me-locally

# Password shared by the seeded realm users (admin, vet, keeper)
ZOO_TEST_USER_PASSWORD=change-me-locally
